{{>header}}
{{>navigation}}
 {{#games}}
        <ul>
            <li>
            <form action="/editgame/{{title}}">
                <div class="gameCard" id='{{title}}'>
                   <strong>{{title}}</strong>{{company}}
                    <p>{{description}}</p>
                    <span>Price: {{price}}</span>
                    <span>Number on Hand: {{numberonhand}}</span>
                </div>
                <button>Edit</button>
            </form>
            </li>
            
        </ul>
    {{/games}}
    <form action="/addgame">
         <button id="addButton">Add New Game Entry</button>
    </form>

    <ul id="messages"></ul>
    <script src="/socket.io/socket.io.js"></script>
    <script src="https://code.jquery.com/jquery-1.11.1.js"></script>
   
   
   <script>      
      
      // create the connection
      var socket = io();      

      
      socket.on('botactivity', function(msg) {
                  
        $('#messages').append($('<li>').text(msg));
      }); 
         
    </script>
    
